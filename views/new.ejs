<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>New Chat</title>
</head>
<body>
   <h2>Create New Chat here</h2>
   <form method="post" action="/chats">
    <input placeholder="Your name" name="from">
    <br>
    <textarea name="msg" rows="5" cols="10">Write your messages here!</textarea>
    <br>
    <input placeholder="Receiver name" name="to">
    <br>
    <button type="submit">Create chat</button>
   </form>
</body>
</html>