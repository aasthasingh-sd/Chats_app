<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Chat Section</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
   <h2>Chats</h2>
   <br><br>
   <form method="get" action="/chats/new">
      <button type="submit">Create new Chat</button>
   </form>
   <div class="chats">
  <% for( let chat of chats) { %>
     <div class="chat">
        <p>From:<%=chat.from%></p>
        <br>
        <p>msg:<%=chat.msg%></p>
        <br>
        <p>Received by:<%=chat.to%></p>
        <br>
        <hr>
        <p><%=chat.created_at.toString().split(" ")[4]%></p>
        <p><%=chat.created_at.toString().split(" ").slice(0,4).join(" ")%></p>
        <br><br>
        <form action="/chats/<%=chat.id%>/edit" method="get">
         <button>Edit</button>
        </form>
        <br>
        <form action="/chats/<%=chat.id%>?_method=DELETE" method="post">
         <button>Delete</button>
        </form>
        <br><br>
     </div>
   <% } %>
   </div>
</body>
</html>
